generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Emisor {
  id                     Int          @id @default(autoincrement())
  nit                    String       @unique @db.VarChar(14)
  nrc                    String?      @db.VarChar(10)
  nombre_comercial       String?      @db.VarChar(150)
  razon_social           String?      @db.VarChar(150)
  cod_actividad          String?      @db.VarChar(6)
  desc_actividad         String?      @db.VarChar(150)
  cod_establecimiento_mh String?      @default("0000") @db.VarChar(4)
  cod_punto_venta_mh     String?      @default("0000") @db.VarChar(4)
  direccion              Json?
  telefono               String?      @db.VarChar(20)
  correo                 String?      @db.VarChar(100)
  pwd_mh                 String?      @db.VarChar(255)
  pwd_firmador           String?      @db.VarChar(255)
  created_at             DateTime?    @default(now()) @db.Timestamp(6)
  ambiente               String?      @default("00") @db.VarChar(2)
  dtes_visibles          Json?
  password               String?      @db.VarChar(255)
  logo_url               String?      @db.Text
  clientes               Cliente[]
  compras                Compra[]
  dtes                   DteEmitido[]
  productos              Producto[]
  correlativos           Correlativo[]
  eventos                EventoDte[]
  conexion_correo        ConexionCorreo?
  importaciones_correo   ImportacionCorreo[]
  configuracion_contable ConfiguracionContable?
  periodos_contables     PeriodoContable[]

  @@map("emisores")
}

model Cliente {
  id               Int          @id @default(autoincrement())
  emisor_id        Int?
  tipo_documento   String       @db.VarChar(2)
  num_documento    String       @db.VarChar(20)
  nrc              String?      @db.VarChar(10)
  nombre           String       @db.VarChar(200)
  nombre_comercial String?      @db.VarChar(150)
  cod_actividad    String?      @db.VarChar(6)
  desc_actividad   String?      @db.VarChar(150)
  correo           String?      @db.VarChar(100)
  telefono         String?      @db.VarChar(20)
  direccion        Json?
  created_at       DateTime?    @default(now()) @db.Timestamp(6)
  emisor           Emisor?      @relation(fields: [emisor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  dtes             DteEmitido[]

  @@unique([emisor_id, num_documento])
  @@map("clientes")
}

model CatalogoMh {
  id            Int      @id @default(autoincrement())
  tipo_catalogo String   @db.VarChar(50)
  codigo        String   @db.VarChar(10)
  valor         String   @db.VarChar(255)
  activo        Boolean? @default(true)

  @@unique([tipo_catalogo, codigo])
  @@map("catalogos_mh")
}

model DteEmitido {
  id                    Int       @id @default(autoincrement())
  emisor_id             Int
  cliente_id            Int?
  tipo_dte              String    @db.VarChar(2)
  codigo_generacion     String    @unique @db.Uuid
  numero_control        String    @db.VarChar(31)
  ambiente              String    @default("00") @db.VarChar(2)
  sello_recepcion_mh    String?   @db.VarChar(40)
  estado                String?   @default("PROCESANDO") @db.VarChar(20)
  fecha_emision         DateTime  @db.Date
  hora_emision          DateTime  @db.Time(6)
  monto_total_operacion Decimal   @db.Decimal(12, 2)
  total_pagar           Decimal   @db.Decimal(12, 2)
  json_enviado          Json?
  respuesta_mh          Json?
  descripcion_rechazo   String?   @db.Text
  created_at            DateTime? @default(now()) @db.Timestamp(6)
  items                 DteItem[]
  cliente               Cliente?  @relation(fields: [cliente_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  emisor                Emisor    @relation(fields: [emisor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([emisor_id, ambiente, numero_control])
  @@index([emisor_id, estado])
  @@map("dtes_emitidos")
}

model EventoDte {
  id                 Int       @id @default(autoincrement())
  emisor_id          Int
  dte_id             Int?
  tipo               String    @db.VarChar(20)
  ambiente           String    @default("00") @db.VarChar(2)
  codigo_generacion  String    @unique @db.Uuid
  estado             String    @default("PROCESANDO") @db.VarChar(20)
  sello_recepcion_mh String?   @db.VarChar(40)
  json_enviado       Json?
  respuesta_mh       Json?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  emisor             Emisor    @relation(fields: [emisor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([emisor_id, tipo])
  @@map("eventos_dte")
}

model Correlativo {
  emisor_id             Int
  ambiente              String @db.VarChar(2)
  tipo_dte              String @db.VarChar(2)
  establecimiento_punto String @db.VarChar(8)
  ultimo                BigInt
  emisor                Emisor @relation(fields: [emisor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([emisor_id, ambiente, tipo_dte, establecimiento_punto])
  @@map("correlativos")
}

model DteItem {
  id              Int         @id @default(autoincrement())
  dte_id          Int?
  num_item        Int
  cantidad        Decimal     @db.Decimal(10, 2)
  descripcion     String      @db.VarChar(255)
  precio_unitario Decimal     @db.Decimal(10, 2)
  venta_gravada   Decimal?    @default(0) @db.Decimal(10, 2)
  venta_exenta    Decimal?    @default(0) @db.Decimal(10, 2)
  venta_nosujeta  Decimal?    @default(0) @db.Decimal(10, 2)
  iva_item        Decimal?    @default(0) @db.Decimal(10, 2)
  tributos        Json?
  dte             DteEmitido? @relation(fields: [dte_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("dte_items")
}

model ConfiguracionSistema {
  id          Int     @id @default(autoincrement())
  clave       String  @unique @db.VarChar(50)
  valor       String
  descripcion String? @db.VarChar(255)

  @@map("configuraciones_sistema")
}

model Producto {
  id              Int       @id @default(autoincrement())
  emisor_id       Int
  codigo          String    @db.VarChar(50)
  descripcion     String    @db.VarChar(255)
  precio_unitario Decimal   @db.Decimal(10, 2)
  tipo_item       Int       @default(1)
  uni_medida      Int       @default(59)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  emisor          Emisor    @relation(fields: [emisor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([emisor_id, codigo])
  @@map("productos")
}

model Compra {
  id                  Int          @id @default(autoincrement())
  emisor_id           Int
  proveedor_nombre    String       @db.VarChar(200)
  proveedor_documento String       @db.VarChar(20)
  tipo_documento      String       @db.VarChar(2)
  numero_documento    String       @db.VarChar(50)
  fecha_compra        DateTime     @db.Date
  monto_total         Decimal      @db.Decimal(12, 2)
  created_at          DateTime?    @default(now()) @db.Timestamp(6)
  origen              String       @default("MANUAL") @db.VarChar(10)
  codigo_generacion   String?      @db.Uuid
  sello_recepcion     String?      @db.VarChar(60)
  ambiente            String?      @db.VarChar(2)
  observacion         String?      @db.VarChar(255)
  gravada             Decimal?     @db.Decimal(12, 2)
  exenta              Decimal?     @db.Decimal(12, 2)
  iva                 Decimal?     @db.Decimal(12, 2)
  iva_percibido       Decimal?     @db.Decimal(12, 2)
  iva_retenido        Decimal?     @db.Decimal(12, 2)
  periodo_iva         String?      @db.VarChar(7)
  tipo_operacion      Int?
  clasificacion       Int?
  sector              Int?
  tipo_costo_gasto    Int?
  items               CompraItem[]
  archivos            CompraArchivo[]
  emisor              Emisor       @relation(fields: [emisor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([emisor_id, codigo_generacion])
  @@index([emisor_id, fecha_compra])
  @@map("compras")
}

model ConfiguracionContable {
  emisor_id        Int     @id
  tipo_ingreso     Int     @default(2)
  tipo_operacion   Int     @default(1)
  clasificacion    Int     @default(2)
  sector           Int     @default(4)
  tipo_costo_gasto Int     @default(2)
  tasa_pago_cuenta Decimal @default(1.75) @db.Decimal(5, 2)
  emisor           Emisor  @relation(fields: [emisor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("configuraciones_contables")
}

model PeriodoContable {
  emisor_id              Int
  periodo                String  @db.VarChar(7)
  remanente_iva          Decimal @default(0) @db.Decimal(12, 2)
  excedente_pago_cuenta  Decimal @default(0) @db.Decimal(12, 2)
  ingresos_con_retencion Decimal @default(0) @db.Decimal(12, 2)
  emisor                 Emisor  @relation(fields: [emisor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([emisor_id, periodo])
  @@map("periodos_contables")
}

model CompraArchivo {
  id        Int    @id @default(autoincrement())
  compra_id Int
  tipo      String @db.VarChar(4)
  nombre    String @db.VarChar(255)
  contenido Bytes
  compra    Compra @relation(fields: [compra_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([compra_id, tipo])
  @@map("compra_archivos")
}

model ConexionCorreo {
  emisor_id        Int      @id
  host             String   @db.VarChar(255)
  usuario          String   @db.VarChar(100)
  password_cifrada String   @db.Text
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamp(6)
  emisor           Emisor   @relation(fields: [emisor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("conexiones_correo")
}

model ImportacionCorreo {
  id         Int      @id @default(autoincrement())
  emisor_id  Int
  periodo    String   @db.VarChar(5)
  estado     String   @default("EN_PROCESO") @db.VarChar(12)
  total      Int      @default(0)
  revisados  Int      @default(0)
  importadas Int      @default(0)
  duplicadas Int      @default(0)
  ignoradas  Int      @default(0)
  por_revisar Int     @default(0)
  detalle    Json?
  error      String?  @db.Text
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamp(6)
  emisor     Emisor   @relation(fields: [emisor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([emisor_id, created_at])
  @@map("importaciones_correo")
}

model CompraItem {
  id              Int     @id @default(autoincrement())
  compra_id       Int
  descripcion     String  @db.VarChar(255)
  cantidad        Decimal @db.Decimal(10, 2)
  precio_unitario Decimal @db.Decimal(10, 2)
  total           Decimal @db.Decimal(10, 2)
  compra          Compra  @relation(fields: [compra_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("compra_items")
}
